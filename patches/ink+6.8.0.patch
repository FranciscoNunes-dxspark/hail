--- /dev/null
+++ b/node_modules/ink/build/text-width.js
@@ -0,0 +1,38 @@
+import stringWidth from 'string-width';
+// Columns a line takes up (patched in by the family). Most lines are printable ASCII, maybe coloured,
+// where that is their length without the colour codes. Lines of characters that never join the next
+// (the apps' text.js SIMPLE: Latin, box drawing, arrows, CJK, single emoji...) are as wide as their
+// characters, each measured once; string-width measures the rest whole.
+const ASCII = /^[\x20-\x7e]*$/;
+const SIMPLE = /^[\x20-\x7e\xa0-\u02ff\u0370-\u0482\u2010-\u2027\u2030-\u205e\u2070-\u20cf\u2100-\u27bf\u2800-\u2bff\u3000-\u3029\u3030-\u303f\u3041-\u3098\u309b-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uff01-\uff9d\u{1f300}-\u{1f3fa}\u{1f400}-\u{1faff}]*$/u;
+const SGR = /\x1b\[[\d;:]*m/g;
+const chars = new Map();
+const plainWidth = (text) => {
+    if (ASCII.test(text)) {
+        return text.length;
+    }
+    if (!SIMPLE.test(text)) {
+        return undefined;
+    }
+    let width = 0;
+    for (const char of text) {
+        let w = chars.get(char);
+        if (w === undefined) {
+            chars.set(char, (w = stringWidth(char)));
+        }
+        width += w;
+    }
+    return width;
+};
+export const lineWidth = (line) => {
+    const width = plainWidth(line.includes('\x1b') ? line.replace(SGR, '') : line);
+    return width === undefined ? stringWidth(line) : width;
+};
+/** widest-line's answer: the widest of the text's lines. */
+export const widestLine = (text) => {
+    let width = 0;
+    for (const line of text.split('\n')) {
+        width = Math.max(width, lineWidth(line));
+    }
+    return width;
+};
